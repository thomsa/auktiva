COMPOSE_PROFILES=proxy
REALTIME_HOSTNAME=push.example.org
ACME_EMAIL=admin@example.org
REALTIME_APP_ID=auktiva
REALTIME_APP_KEY=replace-with-a-generated-key
REALTIME_APP_SECRET=replace-with-a-generated-secret
# Use exact browser origins, including scheme and any non-default port.
REALTIME_ALLOWED_ORIGINS=https://auctions.example.org
# Loopback listener port for the no-proxy service.
REALTIME_BIND=6001
